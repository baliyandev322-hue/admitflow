# ADMITFLOW AI PRODUCTION ENVIRONMENT CONFIGURATION
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://admitflow.ai

# Security & Authentication (Generate using: openssl rand -base64 32)
JWT_SECRET=your_production_jwt_secret_min_32_chars

# Database (Supabase / Neon / AWS RDS PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/admitflow?sslmode=require

# AI LLM & Vector Embeddings
GEMINI_API_KEY=your_google_gemini_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_key_here

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Messaging Channels (WhatsApp Cloud API - Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_phrase
